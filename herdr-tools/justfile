# herdr-tools recipes. Run from anywhere with `just -f herdr-tools/justfile <recipe>`;
# just runs every recipe from this directory.

set shell := ["bash", "-euo", "pipefail", "-c"]

# The laid-out plugin dir that `herdr plugin link` points at. Releases unpack to
# the same path, so dev and release installs replace each other cleanly.
plugin_dir := env("XDG_DATA_HOME", env("HOME") / ".local/share") / "herdr/plugins/shadowfax.tools"
# The retired plugin repos, for the transition checks in `real`.
old_plugins := env("HERDR_OLD_PLUGINS", env("HOME") / "code/side-projects/herdr-custom-plugins/my")

default: ci

# Formatting, lints as errors, then every test. The gate before any commit.
ci:
    cargo fmt --all --check
    cargo clippy --workspace --all-targets --locked -- -D warnings
    cargo test --workspace --locked

fmt:
    cargo fmt --all

# Build release and copy the binary to bin/, as the manifest's [[build]] does.
bin:
    cargo build --release --locked
    mkdir -p bin
    cp target/release/herdr-tools bin/herdr-tools

# Real-herdr checks, each in its own throwaway isolated server (never the default
# session). Every mode's suite runs against the built plugin. find's real_herdr.py
# is left out: it stops at a done-agent fixture that also fails with the old
# herdr-jump binary on this fork build, so it measures herdr, not this plugin.
real: bin
    cargo build -p tools-core --example open_popup --locked
    cargo build -p tools-menu --example fork_probe --locked
    python3 tests/real_scaffold.py
    python3 crates/find/tests/real_find.py
    python3 crates/find/tests/slow_host.py
    uv run --quiet --with pyte==0.8.2 python crates/find/tests/real_paths.py
    uv run --quiet --with pyte==0.8.2 python crates/find/tests/real_recent_files.py
    python3 crates/move/tests/real_move.py
    python3 crates/menu/tests/real_menu.py
    # Focus and hide need a Herdr with `herdr scope`; on one without, a SKIP line.
    python3 crates/menu/tests/real_scope.py
    python3 crates/find/tests/real_scope_toggle.py
    python3 crates/menu/tests/headless_fork.py target/debug/examples/fork_probe
    python3 crates/menu/tests/real_fork_rows.py bin/herdr-tools
    python3 crates/menu/tests/real_redistribution.py bin/herdr-tools
    python3 crates/comment/tests/real_comment.py
    python3 crates/layout/tests/real_grid.py
    python3 crates/layout/tests/real_actions.py
    python3 crates/scratch/tests/actions_real.py
    python3 crates/scratch/tests/cleanup_real.py bin/herdr-tools
    python3 crates/scratch/tests/context_real.py bin/herdr-tools
    # Transition checks drive the old plugins' own builds (the old menu's reap
    # item, the old scratch's live sessions), so they run only while those exist.
    if [ -x "{{old_plugins}}/herdr-menu/target/release/herdr-menu" ]; then python3 crates/scratch/tests/reap_menu_real.py bin/herdr-tools; else echo "skip reap_menu_real.py: no old herdr-menu build"; fi
    if [ -x "{{old_plugins}}/herdr-scratch/target/release/herdr-scratch" ]; then python3 crates/scratch/tests/cutover_real.py "{{old_plugins}}/herdr-scratch/target/release/herdr-scratch" bin/herdr-tools link; else echo "skip cutover_real.py: no old herdr-scratch build"; fi

# Build release, lay out {{plugin_dir}} by rename, and link it unless Herdr
# already links shadowfax.tools from there. Uses the herdr on PATH (override
# with HERDR=…) and whatever server it reaches: point XDG_CONFIG_HOME and
# XDG_DATA_HOME at temp dirs and unset HERDR_SOCKET_PATH to try it in isolation.
install:
    #!/usr/bin/env bash
    set -euo pipefail
    herdr="${HERDR:-herdr}"
    cargo build --release --locked
    dest='{{plugin_dir}}'
    parent="$(dirname "$dest")"
    mkdir -p "$parent"
    # Stage beside the destination so the swap is a same-filesystem rename: the
    # linked dir is either the old tree or the new one, never half-written.
    # scripts/package.sh is the layout the fork release ships too, so a dev
    # install and a release install cannot drift apart.
    stage="$(mktemp -d "$parent/.shadowfax.tools.stage.XXXXXX")"
    # On any exit, an old tree still parked in the stage goes back into place
    # (interrupted mid-swap) before the stage is removed; never lose the only copy.
    restore() {
        if [ ! -e "$dest" ] && [ ! -L "$dest" ] && { [ -e "$stage/previous" ] || [ -L "$stage/previous" ]; }; then
            mv "$stage/previous" "$dest" || { echo "previous plugin kept at $stage/previous" >&2; return; }
        fi
        rm -rf "$stage"
    }
    trap restore EXIT
    trap 'exit 1' HUP INT TERM
    scripts/package.sh target/release/herdr-tools "$stage"
    if [ -e "$dest" ] || [ -L "$dest" ]; then
        mv "$dest" "$stage/previous"
    fi
    if ! mv "$stage/shadowfax.tools" "$dest"; then
        if [ -e "$stage/previous" ] || [ -L "$stage/previous" ]; then
            mv "$stage/previous" "$dest"
        fi
        exit 1
    fi
    echo "Installed $dest"
    # Running processes (the scratch cleanup worker) keep the old binary's inode;
    # the next start runs the new one. Linking the same id from another dir
    # replaces that link, so only an exact plugin_root match skips the link.
    linked="$("$herdr" plugin list --json | python3 -c '
    import json, os, sys
    dest = os.path.realpath(sys.argv[1])
    plugins = json.load(sys.stdin)["result"]["plugins"]
    print(any(p.get("plugin_id") == "shadowfax.tools"
              and os.path.realpath(p.get("plugin_root") or "/nonexistent") == dest
              for p in plugins))
    ' "$dest")"
    if [ "$linked" = "True" ]; then
        echo "shadowfax.tools is already linked from $dest"
    else
        "$herdr" plugin link "$dest"
    fi
